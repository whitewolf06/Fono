# Fono Server example for /etc/fono/server.toml.
# Network contract: docs/server-security.md.
# Keep the loopback bind unless access from another host is explicitly needed.
# Set FONO_CONFIG to use another file, or pass --config to the CLI.
# Individual fields can be overridden with FONO_<SECTION>_<KEY>.
# String overrides use raw values, for example FONO_SERVER_BIND=127.0.0.1:17832.
# Array overrides use TOML syntax, for example:
# FONO_MODELS_PRELOAD='["whisper:large_turbo"]'
# FONO_MODELS_PLACEMENT='[{model="whisper:large_turbo",device="cpu"}]'

[server]
bind = "127.0.0.1:17832"
# Exact hostnames/IP literals without ports. IPv6 may be written as ::1 or [::1].
allowed_hosts = ["localhost", "127.0.0.1", "::1"]
# Non-loopback bind requires this explicit assertion and an explicit host list.
# Enable only when access is restricted to a protected private network/tunnel.
trusted_private_network = false
tokens_file = "/etc/fono/tokens"
max_upload_mb = 100
max_audio_seconds = 300
body_read_timeout = "60s"
shutdown_grace = "10s"

# Optional native rustls HTTPS. Mount the whole certificate directory read-only
# so atomic renewal is visible. SIGHUP validates and replaces cert/key together.
# [tls]
# cert = "/etc/fono/tls/cert.pem"
# key = "/etc/fono/tls/key.pem"

[models]
dir = "/var/lib/fono/models"
default = "whisper:large_turbo"
preload = ["whisper:large_turbo"]
max_loaded = 2
# Admin token may load/unload installed models only when this is enabled.
client_model_load = false

[[models.placement]]
model = "whisper:large_turbo"
device = "cpu" # The default build is CPU-only; the CUDA image also accepts cuda:N.
residency = "resident" # The default model stays loaded to keep /healthz ready.

[[models.placement]]
model = "giga_am:v3_e2e_rnnt_int8"
device = "cpu"
residency = "idle_unload"
idle_unload_after = "30m"

[queue]
max_queued = 32
max_inflight_per_token = 2
cpu_parallel = 2
# Per-token concurrency and CPU parallelism are applied by the SRV-06 scheduler.

[metrics]
enabled = false

[logging]
# JSON events on stdout; no RUST_LOG override or raw native messages.
level = "info" # off, error, warn, info, debug

[rate_limit]
enabled = true
requests_per_minute = 120
burst = 20
# This per-credential token bucket is separate from queue/inflight limits.
