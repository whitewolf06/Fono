{
  "openapi": "3.0.3",
  "info": {
    "title": "Fono Server API",
    "version": "2.0.0",
    "description": "Standalone speech recognition API. All responses carry X-Request-Id. Models and devices are discovered from this server; availability is never inferred from desktop settings. JSON jobs retain protocol_version 1 for compatibility."
  },
  "servers": [{ "url": "http://127.0.0.1:17832", "description": "Default loopback listener; use the configured protected endpoint." }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/healthz": { "get": { "summary": "Minimal readiness probe", "security": [], "responses": { "200": { "description": "Default model ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicHealth" } } } }, "503": { "description": "Starting, failed, or stopping", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicHealth" } } } } } } },
    "/v1/health": { "get": { "summary": "Model readiness and queue state", "responses": { "200": { "description": "Ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "503": { "description": "Starting or failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } } } },
    "/v1/capabilities": { "get": { "summary": "Discover API version, limits, devices and feature gates", "responses": { "200": { "description": "Current server capabilities", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Capabilities" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/v1/models": { "get": { "summary": "List installed models and their live state", "description": "OpenAI-shaped list with Fono metadata. Only present artifacts or active pool reservations are returned. disk_state=present_unverified is a size/layout observation, not a checksum claim.", "responses": { "200": { "description": "Model inventory", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelList" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "500": { "$ref": "#/components/responses/Internal" } } } },
    "/v1/recognize": {
      "post": {
        "summary": "Recognize one audio body synchronously",
        "description": "Raw audio/L16 uses signed big-endian 16-bit mono PCM at 16 kHz, as required by L16. WAV and Ogg/Opus are decoded to the same internal PCM representation. Disconnect cancels work; native work retains admission until it actually returns. Optional timestamps and glossary must be supported by the selected model.",
        "parameters": [
          { "name": "model", "in": "query", "schema": { "type": "string" }, "description": "Installed public model ID; omitted uses the configured default." },
          { "name": "language", "in": "query", "schema": { "type": "string", "enum": ["auto", "ru", "en"], "default": "auto" } },
          { "name": "timestamps", "in": "query", "schema": { "type": "string", "enum": ["none", "segments", "words"], "default": "none" } },
          { "name": "decoding", "in": "query", "schema": { "type": "string", "enum": ["fast", "accurate"], "default": "fast" } },
          { "name": "priority", "in": "query", "schema": { "type": "string", "enum": ["interactive", "batch"], "default": "interactive" } },
          { "name": "X-Fono-Glossary", "in": "header", "description": "Base64url-encoded UTF-8 JSON string array; decoded JSON at most 4096 bytes. Native limits also apply: at most 32 terms and 896 term bytes in total. Unsupported model options fail explicitly.", "schema": { "type": "string", "maxLength": 5464 } },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "requestBody": { "required": true, "content": {
          "audio/L16;rate=16000;channels=1": { "schema": { "type": "string", "format": "binary" } },
          "audio/wav": { "schema": { "type": "string", "format": "binary" } },
          "audio/ogg;codecs=opus": { "schema": { "type": "string", "format": "binary" } }
        } },
        "responses": {
          "200": { "description": "Recognized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Recognition" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/ModelNotFound" }, "408": { "$ref": "#/components/responses/BodyTimeout" }, "413": { "$ref": "#/components/responses/TooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedAudio" }, "429": { "$ref": "#/components/responses/Busy" }, "500": { "$ref": "#/components/responses/Internal" }, "502": { "$ref": "#/components/responses/WorkerFailed" }, "503": { "$ref": "#/components/responses/ModelNotReady" }
        }
      }
    },
    "/v1/audio/transcriptions": {
      "post": {
        "summary": "OpenAI-compatible synchronous transcription",
        "description": "For OpenAI SDK clients using base_url ending in /v1. Work uses the batch scheduler. file must contain a complete supported WAV, MP3, FLAC, Ogg/Vorbis or Ogg/Opus file. temperature is accepted as a finite number from 0 through 1 and ignored. prompt is limited to 224 UTF-8 bytes and requires a model with initial-prompt support; larger inputs fail instead of being silently truncated. Unsupported fields or capabilities fail explicitly.",
        "parameters": [{ "$ref": "#/components/parameters/RequestId" }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": {
          "type": "object", "required": ["file", "model"], "properties": {
            "file": { "type": "string", "format": "binary" }, "model": { "type": "string", "description": "Installed public model ID, for example whisper:tiny." },
            "language": { "type": "string", "enum": ["auto", "ru", "en"] }, "prompt": { "type": "string", "maxLength": 224, "description": "Initial context, at most 224 UTF-8 bytes. The model must support initial prompts. Larger values are rejected without truncation." },
            "response_format": { "type": "string", "enum": ["json", "text", "srt", "vtt", "verbose_json"], "default": "json" },
            "timestamp_granularities[]": { "type": "array", "items": { "type": "string", "enum": ["segment", "word"] }, "description": "verbose_json only; omitted defaults to segment timing." },
            "temperature": { "type": "number", "minimum": 0, "maximum": 1, "description": "Accepted for compatibility and ignored." },
            "stream": { "type": "boolean", "enum": [false], "description": "Only completed responses are supported." }
          }
        } } } },
        "responses": { "200": { "description": "Requested response format", "content": {
          "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/OpenAIText" }, { "$ref": "#/components/schemas/OpenAIVerbose" }] } },
          "text/plain": { "schema": { "type": "string" } }, "application/x-subrip": { "schema": { "type": "string" } }, "text/vtt": { "schema": { "type": "string" } }
        } }, "400": { "$ref": "#/components/responses/OpenAIInvalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/ModelNotFound" }, "408": { "$ref": "#/components/responses/BodyTimeout" }, "413": { "$ref": "#/components/responses/TooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedAudio" }, "429": { "$ref": "#/components/responses/Busy" }, "503": { "$ref": "#/components/responses/ModelNotReady" } }
      }
    },
    "/v1/transcriptions": { "post": {
      "summary": "Upload a file and create a compatible asynchronous job",
      "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["audio"], "properties": { "audio": { "type": "string", "format": "binary", "description": "WAV, MP3, FLAC, Ogg/Vorbis or Ogg/Opus." }, "language": { "type": "string", "default": "auto", "maxLength": 64 }, "model": { "type": "string", "description": "Optional installed server model ID." } } } } } },
      "responses": { "202": { "$ref": "#/components/responses/JobAccepted" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/ModelNotFound" }, "408": { "$ref": "#/components/responses/BodyTimeout" }, "413": { "$ref": "#/components/responses/TooLarge" }, "415": { "$ref": "#/components/responses/UnsupportedAudio" }, "429": { "$ref": "#/components/responses/Busy" } }
    } },
    "/v1/transcription-jobs": { "post": {
      "summary": "Create a compatible batch job from normalized PCM",
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TranscriptionRequest" } } } },
      "responses": { "202": { "$ref": "#/components/responses/JobAccepted" }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/ModelNotFound" }, "408": { "$ref": "#/components/responses/BodyTimeout" }, "413": { "$ref": "#/components/responses/TooLarge" }, "429": { "$ref": "#/components/responses/Busy" } }
    } },
    "/v1/transcription-jobs/{id}": { "get": { "summary": "Read one job", "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "description": "Job", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "Job not found" } } } },
    "/v1/transcription-jobs/{id}/cancel": { "post": { "summary": "Cancel a queued or active job", "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "description": "Current cancelled job", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "Job not found" } } } },
    "/v1/models/{id}/load": { "post": { "summary": "Load one installed model", "description": "Admin token and models.client_model_load=true required. Verifies pinned artifact checksums before loading. Never downloads a model.", "parameters": [{ "$ref": "#/components/parameters/ModelId" }], "responses": { "200": { "$ref": "#/components/responses/ModelCommand" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/ModelNotFound" }, "422": { "description": "Model checksum or configured backend is invalid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "429": { "$ref": "#/components/responses/Busy" }, "503": { "$ref": "#/components/responses/ModelNotReady" } } } },
    "/v1/models/{id}/unload": { "post": { "summary": "Unload one idle model", "description": "Admin token and models.client_model_load=true required. Default model cannot be unloaded. Active inference, loading, or pending native cleanup retain pool admission.", "parameters": [{ "$ref": "#/components/parameters/ModelId" }], "responses": { "200": { "$ref": "#/components/responses/ModelCommand" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/ModelNotFound" }, "409": { "description": "Default model must remain resident" }, "429": { "$ref": "#/components/responses/Busy" } } } },
    "/metrics": { "get": { "summary": "Read bounded Prometheus counters and gauges", "description": "Requires metrics.enabled=true and an admin token. Does not expose content, tokens, file paths, device names or token identities.", "responses": { "200": { "description": "Prometheus text exposition", "content": { "text/plain": { "schema": { "type": "string" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "description": "Metrics disabled" } } } },
    "/openapi.json": { "get": { "summary": "Read this server API v2 specification", "responses": { "200": { "description": "OpenAPI document", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/docs": { "get": { "summary": "Read self-contained API documentation", "responses": { "200": { "description": "HTML documentation", "content": { "text/html": { "schema": { "type": "string" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "parameters": {
      "RequestId": { "name": "X-Request-Id", "in": "header", "description": "Optional safe ASCII identifier, at most 128 characters; generated by the server when absent or invalid.", "schema": { "type": "string", "maxLength": 128 } },
      "ModelId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Exact public model ID from /v1/models." },
      "JobId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "Unauthorized": { "description": "Missing, revoked or invalid bearer token" },
      "Forbidden": { "description": "Admin token required or client model control is disabled" },
      "InvalidRequest": { "description": "Invalid parameters, options or body", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "OpenAIInvalid": { "description": "Invalid OpenAI-compatible request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpenAIError" } } } },
      "ModelNotFound": { "description": "Model is unknown or not installed" },
      "BodyTimeout": { "description": "Total body reception deadline exceeded (body_read_timeout), or cancelled model operation" },
      "TooLarge": { "description": "Body size or audio duration exceeds the configured limit" },
      "UnsupportedAudio": { "description": "Unsupported or invalid audio format" },
      "Busy": { "description": "Queue, per-token admission, device or model capacity is busy", "headers": { "Retry-After": { "schema": { "type": "integer", "example": 1 } } } },
      "ModelNotReady": { "description": "The selected model is not ready", "headers": { "Retry-After": { "schema": { "type": "integer", "example": 1 } } } },
      "WorkerFailed": { "description": "Recognizer or worker failed; no transcript is returned" },
      "Internal": { "description": "Server operation failed without exposing internal paths or errors" },
      "JobAccepted": { "description": "Queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } },
      "ModelCommand": { "description": "Current model state", "content": { "application/json": { "schema": { "type": "object", "required": ["id", "state"], "properties": { "id": { "type": "string" }, "state": { "type": "string", "enum": ["ready", "unloaded", "retiring"] } } } } } }
    },
    "schemas": {
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "retryable", "request_id"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" }, "request_id": { "type": "string" } } } } },
      "OpenAIError": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["message", "type", "param", "code", "request_id"], "properties": { "message": { "type": "string" }, "type": { "type": "string", "enum": ["invalid_request_error", "server_error"] }, "param": { "type": "string", "nullable": true }, "code": { "type": "string" }, "request_id": { "type": "string" } } } } },
      "PublicHealth": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["ok", "starting", "failed"] } } },
      "Health": { "type": "object", "required": ["status", "models", "queue"], "properties": { "status": { "type": "string", "enum": ["ready", "starting", "failed"] }, "models": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "state": { "type": "string" }, "device": { "type": "string" } } } }, "queue": { "type": "object", "properties": { "interactive": { "type": "integer" }, "batch": { "type": "integer" } } } } },
      "Capabilities": { "type": "object", "required": ["product", "version", "api_version", "worker_protocol", "audio_formats", "max_audio_seconds", "max_upload_bytes", "body_read_timeout_seconds", "devices", "features"], "properties": { "product": { "type": "string", "enum": ["fono-server"] }, "version": { "type": "string" }, "api_version": { "type": "integer", "enum": [2] }, "worker_protocol": { "type": "integer" }, "audio_formats": { "type": "array", "items": { "type": "string" } }, "max_audio_seconds": { "type": "integer" }, "max_upload_bytes": { "type": "integer", "format": "int64" }, "body_read_timeout_seconds": { "type": "integer" }, "devices": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "threads"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "threads": { "type": "integer" } } } }, "features": { "type": "object", "properties": { "cancel_on_disconnect": { "type": "boolean" }, "glossary": { "type": "boolean" }, "timestamps": { "type": "array", "items": { "type": "string" } }, "decoding": { "type": "array", "items": { "type": "string" } }, "openai_compatible": { "type": "boolean" }, "jobs": { "type": "boolean" }, "client_model_load": { "type": "boolean" }, "metrics": { "type": "boolean" } } } } },
      "ModelList": { "type": "object", "required": ["object", "data"], "properties": { "object": { "type": "string", "enum": ["list"] }, "data": { "type": "array", "items": { "type": "object", "required": ["id", "object", "fono"], "properties": { "id": { "type": "string" }, "object": { "type": "string", "enum": ["model"] }, "fono": { "type": "object", "required": ["engine", "languages", "punctuation", "size_bytes", "state", "disk_state", "device", "default", "features"], "properties": { "engine": { "type": "string" }, "languages": { "type": "array", "items": { "type": "string" } }, "punctuation": { "type": "boolean" }, "size_bytes": { "type": "integer", "format": "int64" }, "state": { "type": "string", "enum": ["ready", "busy", "unloaded", "loading", "retiring", "failed"] }, "disk_state": { "type": "string", "enum": ["missing", "present_unverified", "verified", "invalid"] }, "device": { "type": "string" }, "default": { "type": "boolean" }, "features": { "type": "object" } } } } } } } },
      "TimedText": { "type": "object", "required": ["start_ms", "end_ms", "text"], "properties": { "start_ms": { "type": "integer", "format": "int64" }, "end_ms": { "type": "integer", "format": "int64" }, "text": { "type": "string" } } },
      "Recognition": { "type": "object", "required": ["text", "language", "model", "backend", "device", "segments", "timings", "request_id"], "properties": { "text": { "type": "string" }, "language": { "type": "string", "nullable": true }, "model": { "type": "string" }, "backend": { "type": "string", "nullable": true }, "device": { "type": "string", "nullable": true }, "segments": { "type": "array", "items": { "$ref": "#/components/schemas/TimedText" } }, "words": { "type": "array", "items": { "$ref": "#/components/schemas/TimedText" } }, "timings": { "type": "object", "properties": { "queue_ms": { "type": "integer", "nullable": true }, "load_ms": { "type": "integer", "nullable": true }, "decode_ms": { "type": "integer", "nullable": true }, "audio_ms": { "type": "integer" }, "total_ms": { "type": "integer" } } }, "request_id": { "type": "string" } } },
      "TranscriptionRequest": { "type": "object", "required": ["pcm_samples", "language"], "properties": { "pcm_samples": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": -32768, "maximum": 32767 }, "description": "Mono normalized PCM at 16 kHz; duration limit applies." }, "language": { "type": "string" }, "model": { "type": "string", "nullable": true } } },
      "Job": { "type": "object", "required": ["id", "requested_language", "state", "created_at_ms"], "properties": { "id": { "type": "string" }, "requested_language": { "type": "string" }, "state": { "type": "string", "enum": ["queued", "preparing", "transcribing", "completed", "failed", "cancelled"] }, "created_at_ms": { "type": "integer", "format": "int64" }, "started_at_ms": { "type": "integer", "format": "int64", "nullable": true }, "finished_at_ms": { "type": "integer", "format": "int64", "nullable": true }, "result": { "type": "object", "nullable": true, "description": "Compatible TranscriptionResult with protocol_version 1 and real optional timed segments." }, "error": { "type": "object", "nullable": true } } },
      "OpenAIText": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } },
      "OpenAIVerbose": { "type": "object", "required": ["task", "language", "duration", "text"], "properties": { "task": { "type": "string", "enum": ["transcribe"] }, "language": { "type": "string", "nullable": true }, "duration": { "type": "number" }, "text": { "type": "string" }, "segments": { "type": "array", "items": { "type": "object", "required": ["id", "start", "end", "text"], "properties": { "id": { "type": "integer" }, "start": { "type": "number" }, "end": { "type": "number" }, "text": { "type": "string" } } } }, "words": { "type": "array", "items": { "type": "object", "required": ["word", "start", "end"], "properties": { "word": { "type": "string" }, "start": { "type": "number" }, "end": { "type": "number" } } } } } }
    }
  }
}
