{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fono",
  "version": "0.1.0",
  "identifier": "com.fono.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:workers"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Fono — Настройки",
        "url": "index.html",
        "width": 900,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Fono Overlay",
        "url": "index.html?view=overlay",
        "width": 280,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "x": 560,
        "y": 40,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "Fono"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["resources/whisper/*", "resources/sherpa-onnx/*", "resources/stt-workers/*"],
    "copyright": "© 2026 Fono",
    "category": "Productivity",
    "shortDescription": "Голосовой ввод для Windows",
    "longDescription": "Локальный голосовой ввод в любое окно Windows: транскрипция на whisper.cpp и AI-обработка через LM Studio. Полностью офлайн.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
