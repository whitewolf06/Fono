{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fono",
  "version": "0.6.6",
  "identifier": "com.fono.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run prepare:release-resources"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "Fono",
        "url": "v3.html",
        "width": 900,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "theme": "Dark",
        "backgroundColor": "#020914",
        "visible": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Fono Overlay",
        "url": "v3.html?view=overlay",
        "width": 286,
        "height": 88,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "center": false,
        "x": 560,
        "y": 40,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "Fono"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/whisper/*": "resources/whisper/",
      "resources/stt-workers/*": "resources/stt-workers/",
      "resources/sherpa-onnx/*.dll": "",
      "resources/vad/*.onnx": "resources/vad/"
    },
    "copyright": "© 2026 Fono",
    "category": "Productivity",
    "shortDescription": "Голосовой ввод для Windows",
    "longDescription": "Локальный голосовой ввод в любое окно Windows: транскрипция на whisper.cpp и AI-обработка через LM Studio. Полностью офлайн.",
    "windows": {
      "wix": {
        "template": "./windows/templates/fono.wxs"
      },
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
